# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Публичный HTTPS-адрес витрины. Локально — адрес туннеля (см. README), на сервере — ваш домен
WEBAPP_URL=https://shop.example.com
WEB_PORT=8080

# Токен платёжного провайдера: @BotFather → ваш бот → Payments (например, «ЮKassa: тест»).
# Пусто — демо-оплата: весь путь заказа работает, но без списания денег
PAYMENT_PROVIDER_TOKEN=
CURRENCY=RUB

DATABASE_URL=sqlite+aiosqlite:///shop.db
# REDIS_URL=redis://localhost:6379/0

SHOP_NAME=Зерно · обжарочная
PICKUP_ADDRESS=Москва, ул. Примерная, 1
SUPPORT_CONTACT=@your_support
# Рубли
DELIVERY_PRICE=300
FREE_DELIVERY_FROM=3000
ORDER_TTL_MINUTES=30
TIMEZONE=Europe/Moscow

# Только для docker compose с HTTPS (Caddy сам получит сертификат)
DOMAIN=shop.example.com
